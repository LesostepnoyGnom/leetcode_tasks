/*
https://leetcode.com/problems/partition-array-according-to-given-pivot/
Medium

You are given a 0-indexed integer array nums and an integer pivot. Rearrange nums such that the following conditions are satisfied:

Every element less than pivot appears before every element greater than pivot.
Every element equal to pivot appears in between the elements less than and greater than pivot.
The relative order of the elements less than pivot and the elements greater than pivot is maintained.
More formally, consider every pi, pj where pi is the new position of the ith element and pj is the new position of the jth element. If i < j and both elements are smaller (or larger) than pivot, then pi < pj.
Return nums after the rearrangement.
*/

class Solution {
public:
    vector<int> pivotArray(vector<int>& nums, int pivot) {
        vector<int> sorted_vector;    // сюда будем записывать числа в нужно порядке
        vector<int> eq_pivot;         // сюда будем записывать числа к-е равны pivot
        vector<int> greater_pivot;    // сюда будем записывать числа к-е больше чем pivo

        for(int i = 0; i < nums.size(); i++){    // проходимся по всему массиву
            if(nums[i] < pivot){                 // числа к-е меньше чем pivot сразу записываем в итоговый вектор
                sorted_vector.push_back(nums[i]);
            }
            // далее отбираем остальные числа
            else if(nums[i] == pivot) {
                eq_pivot.push_back(nums[i]);
            }
            else{
                greater_pivot.push_back(nums[i]);
            }
        }

        for(int i = 0; i < eq_pivot.size(); i++){ // добавляем числа к-е равны pivot в итоговый вектор
            sorted_vector.push_back(eq_pivot[i]);
        }

        for(int i = 0; i < greater_pivot.size(); i++){ // добавляем числа к-е больше pivot в итоговый вектор
            sorted_vector.push_back(greater_pivot[i]);
        }

        return sorted_vector;
    }
};
